  "window_note": "Every window is judged against the RELEVANT ISSUE TIME, never wall-clock now, so an archived bundle still verifies years later in an adjudication. The enrollment cert is judged against the token's issued_at; the token is judged against the session start. A date-only expires_at is inclusive THROUGH THE END of that day, exactly as course_cert.valid_until — same resolution rule, implemented once.",
  "token_window_cases": [
    {
      "name": "in_window",
      "note": "Mid-semester.",
      "input": {
        "issued_at": "2026-09-01T00:00:00Z",
        "expires_at": "2027-01-15",
        "at": "2026-10-01T00:00:00Z"
      },
      "expected": {
        "in_window": true
      }
    },
    {
      "name": "before_issued",
      "note": "Session predates issuance.",
      "input": {
        "issued_at": "2026-09-01T00:00:00Z",
        "expires_at": "2027-01-15",
        "at": "2026-08-25T00:00:00Z"
      },
      "expected": {
        "in_window": false,
        "reason": "before_valid_from"
      }
    },
    {
      "name": "date_only_expiry_covers_that_whole_day",
      "note": "expires_at 2027-01-15 covers all of Jan 15.",
